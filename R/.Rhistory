resid <- t(residuals(VAR_model))
gIRF_sum_boot <- matrix(0, nrow = H + 1, ncol = B)
jIRF_boot <- array(0, dim = c(K, H + 1, B))
gIRF_indiv_boot = list()
for (name in from_set) {
gIRF_indiv_boot[[name]] <- matrix(0, nrow = H + 1, ncol = B)
}
for (i in 1:B) {
if (i %% 500 == 0) cat("Bootstrap iteration:", i, "\n")   #This provides a progress indicator on the bootstrap iterations.
idx <- sample(1:(T - p_lag), replace = TRUE)
boot_resid <- resid[, idx]
boot_resid <- boot_resid - rowMeans(boot_resid)
Ynew <- matrix(0, nrow = K, ncol = T)
Ynew[, 1:p_lag] <- Y[, 1:p_lag]
for (t in (p_lag + 1):T) {
yhat <- setup$constant
for (lag in 1:p_lag) {
yhat <- yhat + setup$coef_matrices[, , lag] %*% Ynew[, t - lag]
}
Ynew[, t] <- yhat + boot_resid[, t - p_lag]
}
model_boot <- VAR(as.data.frame(t(Ynew)), p = p_lag, type = "const")
sigma_u_boot <- summary(model_boot)$covres
A_boot <- Phi(model_boot, nstep = H)
gIRF <- calculate_gIRF(A_boot, sigma_u_boot, H)
gIRF_sum_boot[, i] <- apply(gIRF[1, from_indices, , drop = FALSE], 3, sum)   #THIS ONLY WORKS FOR THE FIRST VARIABLE.
# Store each individual gIRF to response 1.
for (name in from_set) {
j <- which(var_names == name)
gIRF_indiv_boot[[name]][, i] <- gIRF[1, j, ]   #THIS ONLY WORKS FOR THE FIRST VARIABLE.
}
shock_std <- sqrt(diag(sigma_u_boot[from_indices, from_indices]))
for (h in 1:(H + 1)) {
jIRF_boot[, h, i] <- A_boot[, , h] %*% sigma_u_boot %*% e_sel %*%
solve(t(e_sel) %*% sigma_u_boot %*% e_sel) %*% shock_std
}
}
alpha <- (1 - CI_percent)
lower_idx <- round(B * (alpha / 2))
upper_idx <- round(B * (1 - alpha / 2))
gIRF_sum_CI <- apply(gIRF_sum_boot, 1, sort)
jIRF_CI <- apply(jIRF_boot[1, , ], 1, sort)
gIRF_indiv_list <- list()
for (name in from_set) {
sorted <- apply(gIRF_indiv_boot[[name]], 1, sort)
gIRF_indiv_list[[name]] <- list(
mean = rowMeans(gIRF_indiv_boot[[name]]),
lower = sorted[lower_idx, ],
upper = sorted[upper_idx, ]
)
}
output <- list(
gIRF_sum = list(
mean = rowMeans(gIRF_sum_boot),
lower = gIRF_sum_CI[lower_idx, ],
upper = gIRF_sum_CI[upper_idx, ]
),
jIRF = list(
mean = rowMeans(jIRF_boot[1, , ]),
lower = jIRF_CI[lower_idx, ],
upper = jIRF_CI[upper_idx, ]
),
gIRF_indiv = gIRF_indiv_list
)
attr(output, "var_names") <- var_names
return(output)
}
#Now test the function.
BOOT_results=bootstrap_IRFs(VAR_model, from_set=c("BCS", "CS", "DB"), H = H, B = 5000, CI_percent = 0.9)
BOOT_results
test_from_set=c("BCS", "CS", "DB")
for (name in test_from_set) {
j <- which(var_names == name)
gIRF_indiv_boot[[name]][, i] <- gIRF[1, j, ]
}
gIRF
BOOT_results
plot_jIRF_bootstrap_only <- function(boot_results, response, var_names = NULL,
j_color = "black") {
H <- length(boot_results$jIRF$mean) - 1
horizon <- 0:H
if (!is.null(var_names)) {
if (is.character(response)) response <- which(var_names == response)
response_name <- var_names[response]
} else {
response_name <- paste0("Var", response)
}
plot(horizon, boot_results$jIRF$mean, type = "n",
ylim = range(c(boot_results$jIRF$lower, boot_results$jIRF$upper)),
xlab = "Horizon", ylab = "Response",
main = paste("Bootstrapped jIRF for", response_name),
cex.main = 1.3, cex.lab = 1.1, cex.axis = 0.95)
polygon(c(horizon, rev(horizon)),
c(boot_results$jIRF$lower, rev(boot_results$jIRF$upper)),
col = adjustcolor(j_color, alpha.f = 0.2), border = NA)
lines(horizon, boot_results$jIRF$mean, col = j_color, lwd = 2.5, lty = 2)
abline(h = 0, col = "gray40", lty = 2)
grid()
legend("topright", legend = "jIRF", col = j_color, lty = 2, lwd = 2.5, cex = 0.85)
}
plot_jIRF_bootstrap_only(BOOT_results, response=c("BAC"),j_color = "black")
function(boot_results, response, var_names = NULL,
j_color = "black")
ersvtr
rtv
