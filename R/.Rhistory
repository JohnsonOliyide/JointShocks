XiCov_h[,,h] = A_from_can[,,h] %*% sigma_u_can %*% t(A_from_can[,,h])
}
XiCov=rowSums(XiCov_h, dims=2)   #note: by setting the dims=2 for rowSums, it actually sums along the third dimension.
