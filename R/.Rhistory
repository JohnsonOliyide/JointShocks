#The Ynew_test is looking good.
for (t in (p_lag + 1):T) {
yhat <- setup$constant
for (lag in 1:p_lag) {
yhat <- yhat + setup$coef_matrices[, , lag] %*% Ynew[, t - lag]
}
Ynew[, t] <- yhat + boot_resid[, t - p_lag]
}
View(Ynew_test)
View(Ynew)
model_boot = VAR(as.data.frame(t(Ynew)), p = p_lag, type = "const")
sigma_u_boot =summary(model_boot)$covres
A_boot = Phi(model_boot, nstep = H)
#out of curiosity, check the different shock correlation matrices
correlation_mat_boot=summary(model_boot)$corres
correlation_mat_boot
correlation_can
correlation_mat_boot-correlation_can
max(correlation_mat_boot-correlation_can)
min(correlation_mat_boot-correlation_can)
