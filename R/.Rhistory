#yes, if works for H=0 (which only produces the immediate h=0 response).
calculate_jIRF(VAR_output$A,VAR_output$sigma_u,e_sel,shock_std_vec,6)
calculate_gFEVD_gSOT_gSOI <- function(A, sigma_u, XiCov, H) {
if (H<1) {stop("The forecast horizon (H) must be a strictly positive integer.")}
K <- ncol(sigma_u)
A_sigma_sq <- array(0, dim = c(K, K, H))
for (h in 1:H) {
A_sigma_sq[,,h] <- (A[,,h] %*% sigma_u)^2    #Element by element square.
}
A_sigma_sum <- apply(A_sigma_sq, c(1, 2), sum)
FEVD_gen_num <- matrix(0, K, K)
FEVD_gen <- matrix(0, K, K)
for (i in 1:K) {
for (j in 1:K) {
FEVD_gen_num[i, j] <- A_sigma_sum[i, j] / sigma_u[j, j]
FEVD_gen[i, j] <- FEVD_gen_num[i, j] / XiCov[i, i]
}
}
row_sum <- rowSums(FEVD_gen)
SOT_gen <- 100 * (FEVD_gen / row_sum)
SOI_gen <- 100 - sum(diag(SOT_gen)) / K
return(list(FEVD_gen = FEVD_gen, SOT_gen = SOT_gen, SOI_gen = SOI_gen))
}
#############################################
#Now test the calculate_gFEVD_gSOT_gSOI function.
#First build the XiCov matrix, which is an input.
XiCov_h = array(NA, dim = c(K, K, H))
