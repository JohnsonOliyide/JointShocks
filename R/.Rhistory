calculate_gIRF <- function(A, sigma_u, H) {
#if (length(A[1,1,])<H+1) {stop("gIRF time step ahead (H) must be less than the number of VMA matrices (including A_0).  Please decrease H in this 'calculate_gIRF' function or increase H in the 'extract_VAR_parameters' function.")}
G <- sqrt(diag(diag(sigma_u)))
gIRF <- array(NA, dim = c(dim(A)[1], dim(A)[2], H+1))
for (h in 1:(H+1)) {
gIRF[,,h] <- A[,,h] %*% sigma_u %*% solve(G)
}
return(gIRF)
}
######################################
#Now test the calculate_gIRF function.
#copy  the "calculate_gIRF" function from the "core_function" file and paste it into the console.
calculate_gIRF(VAR_output$A,VAR_output$sigma_u,H)
calculate_gIRF(VAR_output$A,VAR_output$sigma_u,0)
calculate_gIRF(VAR_output$A,VAR_output$sigma_u,6)
calculate_jIRF <- function(A, sigma_u, e_sel, shock_std_vec, H) {
#if (length(A[1,1,])<H+1) {stop("jIRF time step ahead (H) must be less than the number of VMA matrices (including A_0).  Please decrease H in this 'calculate_jIRF' function or increase H in the 'extract_VAR_parameters' function.")}
K <- dim(A)[1]
jIRF <- matrix(NA, nrow = K, ncol = H + 1)
for (h in 1:(H + 1)) {
jIRF[, h] <- A[, , h] %*% sigma_u %*% e_sel %*% solve(t(e_sel) %*% sigma_u %*% e_sel) %*% shock_std_vec
}
return(jIRF)
}
