#Test the function line-by line
from_set=c(3,5,6)
B = 5000
CI_percent = 0.90
setup = extract_VAR_parameters(VAR_model, H)
Y = t(VAR_model$y)
T = ncol(Y)
K = nrow(Y)
p_lag = VAR_model$p
var_names =colnames(VAR_model$y)
from_indices=from_set
e_sel=diag(K)[, from_indices]
resid = t(residuals(VAR_model))
